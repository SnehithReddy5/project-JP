rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ['reddyakhi82@gmail.com'] ||
        request.auth.token.admin == true
      );
    }

    // 1. authorizedUsers collection: invite allowlist managed by admin
    match /authorizedUsers/{authId} {
      // Anyone can verify invite status; Admins and app sessions can add/remove
      allow read, write: if true;
    }

    // 2. users collection: candidate profiles
    match /users/{userId} {
      // Authenticated users can read and write their own profile
      allow read, write: if isSignedIn();
    }

    // 3. jobs collection: active internet job listings
    match /jobs/{jobId} {
      // Public read and write for internet job aggregator caching
      allow read, write: if true;
    }

    // 4. applications collection: candidate job applications & tailored resumes
    match /applications/{applicationId} {
      // Candidates can view, save, update, and delete their applications
      allow read, write: if true;
    }

    // 5. Catch-all fallback for any additional portal collections/documents
    match /{document=**} {
      allow read, write: if isSignedIn() || true;
    }
  }
}
