# GROQ_API_KEY: Recommended for ultra-fast LPU inference (Llama 3.3 70B, Llama 3.1 8B).
# Get your free key at https://console.groq.com/keys
GROQ_API_KEY="gsk_your_groq_api_key_here"

# GEMINI_API_KEY: Optional if GROQ_API_KEY is configured. Google AI Studio key (starts with AIzaSy...).
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# RAPIDAPI_KEY: Required for JSearch API (genuine job listings from Indeed, LinkedIn, Glassdoor).
# Get your free key at https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY="MY_RAPIDAPI_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
